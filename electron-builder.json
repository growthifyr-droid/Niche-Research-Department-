{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.prisma",
  "appId": "com.niche.research.department",
  "productName": "Niche Research Department",
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main/index.js",
    "author": "Niche Research Department"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Niche Research Department",
    "uninstallDisplayName": "Niche Research Department"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
