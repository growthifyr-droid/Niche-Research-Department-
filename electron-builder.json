{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.prisma",
  "appId": "com.niche.research.department",
  "productName": "Niche Research Department",
  "copyright": "Copyright © 2026 Niche Research Department. All rights reserved.",
  "buildDependenciesFromSource": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "build/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main/index.js",
    "author": "Niche Research Department",
    "description": "Desktop application for an agentic AI niche research department with in-app auto-updater, SQLite storage, and luxury UI."
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "legalTrademarks": "Niche Research Department"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Niche Research Department",
    "uninstallDisplayName": "Niche Research Department",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
