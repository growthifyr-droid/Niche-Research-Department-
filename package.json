{
  "name": "niche-research-department",
  "productName": "Niche Research Department",
  "appId": "com.niche.research.department",
  "version": "1.0.2",
  "author": "Niche Research Department",
  "description": "Desktop application for an agentic AI niche research department with in-app auto-updater, SQLite storage, and luxury UI.",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-icons.mjs && vite build && node scripts/build-electron.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist": "npm run build && electron-builder",
    "clean": "rm -rf dist dist-electron release",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "@esbuild/win32-x64": "^0.25.0"
  }
}
